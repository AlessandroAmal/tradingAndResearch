# Dashboard env (Vite). Copy to `.env`. Only PUBLIC values here.
# The anon key is browser-safe; NEVER put the service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Local control API (M9 — "Aggiorna" + "Genera analisi AI" buttons).
# Point to the worker API and use the SAME token as the worker's API_TOKEN.
# The token ends up in the browser bundle — fine for local personal use only.
VITE_API_URL=http://127.0.0.1:8787
VITE_API_TOKEN=CHANGE-ME-LOCAL-TOKEN
