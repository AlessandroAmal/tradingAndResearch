# =====================================================================
# Trading & Research Command Center — environment template
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Every value here is a PLACEHOLDER only.
# =====================================================================

# --- Supabase (Postgres storage) ---
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — server/worker side ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Anon/public key — used by the dashboard (safe for the browser).
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Worker behaviour ---
# Path to the YAML config (relative to repo root or absolute).
APP_CONFIG_FILE=config/config.yaml
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Config overrides (optional; override config.yaml values) ---
# Comma-separated symbols override the universe in config.yaml when set.
# APP_UNIVERSE=AAPL,MSFT,SPY
# Account size override (base currency units).
# APP_ACCOUNT_SIZE=100000

# --- Calendar provider: Financial Modeling Prep (free tier) ---
# Get a free key at https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=YOUR-FMP-KEY

# --- Scheduler (cron expressions, optional overrides) ---
# Prices ingestion cadence (default in config.yaml).
# PRICES_CRON=*/15 * * * *
# Calendar ingestion cadence.
# CALENDAR_CRON=0 6 * * *

# --- AI layer (Phase 2 / M3 — Claude, SERVER-SIDE ONLY) ---
# Key stays in the worker; it must NEVER reach the browser.
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY
# Model overrides (optional; defaults live in config.yaml -> ai:).
# Briefings: a capable current model. Tagging: a cheaper high-volume model.
# ANTHROPIC_BRIEFING_MODEL=claude-sonnet-4-6
# ANTHROPIC_TAGGING_MODEL=claude-haiku-4-5-20251001

# --- News providers (Phase 2 / M3) ---
# GDELT + RSS need no key. NewsAPI is optional (off by default in config).
# NEWSAPI_KEY=YOUR-NEWSAPI-KEY

# --- Schedules (optional overrides; defaults in config.yaml) ---
# NEWS_CRON=*/30 * * * *
# TAGGING_CRON=*/30 * * * *
# BRIEFING_MORNING_CRON=30 6 * * *
# BRIEFING_INTRADAY_CRON=0 13,18 * * *
